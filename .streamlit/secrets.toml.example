# 线上部署用的密钥模板（Streamlit Community Cloud）
#
# 用法：把本文件内容整段复制到
#   Streamlit Cloud → 你的 App → 右上角 Settings → Secrets → 粘贴 → Save
# 注意：真正的 .streamlit/secrets.toml 已在 .gitignore 中，永远不会被提交。

# DeepSeek（OpenAI 兼容接口）：https://platform.deepseek.com/
DEEPSEEK_API_KEY = "sk-在这里填写你的 DeepSeek Key"

# strict 工具模式需要 beta 端点；若账号不支持 strict，把 STRICT_TOOLS 设为 "0"
DEEPSEEK_BASE_URL = "https://api.deepseek.com/beta"
DEEPSEEK_MODEL = "deepseek-chat"
STRICT_TOOLS = "1"

# 高德地图 Web 服务 Key（创建时类型必须选「Web 服务」，不是「Web端(JS API)」）
AMAP_KEY = "在这里填写你的高德 Web 服务 Key"

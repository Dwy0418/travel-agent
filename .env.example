# DeepSeek（OpenAI 兼容接口）https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# strict 工具模式需要 beta 端点，默认值即为此；
# 若账号不支持 strict，可把 STRICT_TOOLS 设为 0（代码也会在 400 时自动降级）
DEEPSEEK_BASE_URL=https://api.deepseek.com/beta
DEEPSEEK_MODEL=deepseek-chat
STRICT_TOOLS=1

# 高德地图 Web 服务 Key（类型选「Web服务」）https://console.amap.com/dev/key/app
AMAP_KEY=your_amap_web_service_key

# 3D 片头接高德「Web端(JS API)」用的凭证，和上面的 Web服务 Key 不通用，要另建一条。
# 高德 2.0 SDK 强制第二把安全密钥（jscode）。片头目前跑的是打包内置的 3D 场景，
# 这两把要等真实瓦片接进来才用得上；缺了不影响规划与出行程。
# 提醒：JS Key 会随页面下发到浏览器，务必在高德控制台绑好域名白名单。
AMAP_JS_KEY=your_amap_web_js_key
AMAP_JS_SECURITY=your_amap_js_security_code

# DeepSeek（OpenAI 兼容接口）https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# strict 工具模式需要 beta 端点，默认值即为此；
# 若账号不支持 strict，可把 STRICT_TOOLS 设为 0（代码也会在 400 时自动降级）
DEEPSEEK_BASE_URL=https://api.deepseek.com/beta
DEEPSEEK_MODEL=deepseek-chat
STRICT_TOOLS=1

# 高德地图 Web 服务 Key（类型选「Web服务」）https://console.amap.com/dev/key/app
AMAP_KEY=your_amap_web_service_key
